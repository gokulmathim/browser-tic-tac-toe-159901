---
import ThemeToggle from '../components/ThemeToggle.astro';
const siteTitle = import.meta.env.PUBLIC_APP_TITLE || 'Tic Tac Toe';
const primary = import.meta.env.PUBLIC_PRIMARY_COLOR || '#1976d2';
const secondary = import.meta.env.PUBLIC_SECONDARY_COLOR || '#90caf9';
const accent = import.meta.env.PUBLIC_ACCENT_COLOR || '#f44336';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{siteTitle}</title>
  </head>
  <body>
    <ThemeToggle />
    <slot />
    <script>
      // Apply color palette from env (or defaults) as CSS variables on :root
      (function() {
        const root = document.documentElement;
        root.style.setProperty('--primary', '{primary}');
        root.style.setProperty('--secondary', '{secondary}');
        root.style.setProperty('--accent', '{accent}');
      })();
    </script>
  </body>
</html>

<style>
  :root {
    /* Light theme variables */
    --bg-color: #ffffff;
    --text-color: #111827;
    --text-secondary: #4b5563;
    --border-color: rgba(0, 0, 0, 0.1);
    --card-bg: rgba(255, 255, 255, 1);
    --card-hover-bg: rgba(255, 255, 255, 0.55);
    --shadow-color: rgba(0, 0, 0, 0.1);
    --shadow-hover-color: rgba(0, 0, 0, 0.15);

    /* Palette variables (will be overridden by script using env) */
    --primary: #1976d2;
    --secondary: #90caf9;
    --accent: #f44336;
  }

  body.dark-theme {
    /* Dark theme variables */
    --bg-color: #111827;
    --text-color: #f9fafb;
    --text-secondary: #d1d5db;
    --border-color: rgba(255, 255, 255, 0.2);
    --card-bg: rgba(31, 41, 55, 0.9);
    --card-hover-bg: rgba(31, 41, 55, 0.7);
    --shadow-color: rgba(0, 0, 0, 0.3);
    --shadow-hover-color: rgba(0, 0, 0, 0.4);
  }

  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
    background-color: var(--bg-color);
    color: var(--text-color);
    transition: background-color 0.3s ease, color 0.3s ease;
  }

  /* Improve default text rendering across the app */
  body {
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    font-family: Inter, system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, "Apple Color Emoji", "Segoe UI Emoji";
  }
</style>
